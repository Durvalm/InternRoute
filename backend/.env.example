APP_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

SECRET_KEY=dev-secret-change-me-32chars-min
JWT_SECRET_KEY=dev-jwt-secret-change-me-32chars-min
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=20160

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/internroute
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPERUSER_EMAILS=you@example.com

RESUME_LLM_MODEL=gpt-4.1
OPENAI_API_KEY=

LEETCODE_API_BASE_URL=https://alfa-leetcode-api.onrender.com
LEETCODE_API_TIMEOUT_SECONDS=20

JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_AUTH_TOKEN=
