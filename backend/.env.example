APP_ENV=development
FLASK_DEBUG=1
FLASK_APP=run.py
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

SECRET_KEY=dev-secret-change-me-32chars-min
JWT_SECRET_KEY=dev-jwt-secret-change-me-32chars-min
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=20160
GOOGLE_CLIENT_ID=
# Required when frontend and API use different subdomains (example: app.internroute.com + api.internroute.com)
# Use root domain only (example: internroute.com)
JWT_COOKIE_DOMAIN=

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/internroute
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPERUSER_EMAILS=you@example.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_APP_VERSION=dev
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

RESUME_LLM_MODEL=gpt-4.1
OPENAI_API_KEY=
PROJECT_EVALUATOR_LLM_MODEL=gpt-4.1-mini
GITHUB_API_TOKEN=

LEETCODE_API_BASE_URL=https://alfa-leetcode-api.onrender.com
LEETCODE_API_TIMEOUT_SECONDS=20

JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_AUTH_TOKEN=

# Production notes:
# - Set APP_ENV=production
# - Set CORS_ALLOWED_ORIGINS to your frontend origin (example: https://app.yourdomain.com)
# - Set JWT_COOKIE_DOMAIN to your root domain for subdomain deployments (example: yourdomain.com)
# - Keep FLASK_APP=run.py so `flask db upgrade` works in deploy hooks
